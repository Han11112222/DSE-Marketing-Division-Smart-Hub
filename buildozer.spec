[app]
title = Smart Hub
package.name = smartmarketinghub
package.domain = com.marketing.hub
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 1.0.0
requirements = python3,kivy
orientation = portrait
android.permissions = INTERNET
android.api = 33
android.minapi = 21
android.ndk = 25b
android.archs = arm64-v8a
fullscreen = 0
android.allow_backup = True

[buildozer]
log_level = 2
warn_on_root = 1
